# ---- Landing page (public, inlined at build time) ----
NEXT_PUBLIC_IMESSAGE_NUMBER=+15555550100      # E.164; page builds sms:+1...&body=...
NEXT_PUBLIC_IMESSAGE_LINK=                    # optional: full link that overrides the sms: one
NEXT_PUBLIC_WHATSAPP_NUMBER=15555550100       # digits only, no "+"
NEXT_PUBLIC_PREFILL_TEXT=Hi Higgens

# ---- OpenRouter ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_SITE_URL=https://higgens.app       # sent as HTTP-Referer
OPENROUTER_APP_NAME=Higgens                   # sent as X-Title

# ---- WhatsApp (Meta Cloud API, direct) ----
WHATSAPP_PHONE_NUMBER_ID=                     # Meta App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=                        # permanent System User token
WHATSAPP_VERIFY_TOKEN=                        # any random string; paste the same into Meta webhook config
WHATSAPP_APP_SECRET=                          # Meta App > Settings > Basic
WHATSAPP_API_VERSION=v25.0

# ---- iMessage (Sendblue) ----
IMESSAGE_WEBHOOK_SECRET=                      # random; Sendblue webhook URL = https://<host>/api/webhooks/imessage?secret=<this>
SENDBLUE_API_URL=https://api.sendblue.com/api/send-message
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=                         # your Sendblue number, E.164 (optional if the account has one line)

# ---- Supabase (server only, never NEXT_PUBLIC) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Dev ----
DEV_CHAT_TOKEN=                               # if set, /api/dev/chat works in production with header x-dev-token
